map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name {{ outline_domain | default('_') }};

    client_max_body_size 250M;

    access_log /var/log/nginx/outline-access.log;
    error_log /var/log/nginx/outline-error.log;

    location / {
        proxy_pass http://127.0.0.1:{{ outline_port | default(3000) }};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Suporte para WebSockets (colaboração em tempo real do Outline)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
