NODE_ENV=production
PORT={{ outline_port | default(3000) }}
URL="{{ outline_url }}"
FORCE_HTTPS={{ outline_force_https | default('false') }}
PGSSLMODE=disable

# Segredos da aplicação
SECRET_KEY="{{ outline_secret_key | replace('\\', '\\\\') | replace('"', '\\"') }}"
UTILS_SECRET="{{ outline_utils_secret | replace('\\', '\\\\') | replace('"', '\\"') }}"

# Banco de Dados PostgreSQL (local nativo na VM)
DATABASE_URL=postgres://{{ outline_postgres_user }}:{{ outline_postgres_password | urlencode }}@127.0.0.1:5432/{{ outline_postgres_db }}

# Cache Redis (local nativo na VM)
REDIS_URL=redis://127.0.0.1:6379

# Armazenamento de Arquivos: Google Cloud Storage (via Interoperabilidade S3 / Chave HMAC)
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID="{{ outline_storage_access_key }}"
AWS_SECRET_ACCESS_KEY="{{ outline_storage_secret_key }}"
AWS_REGION="{{ outline_bucket_region }}"
AWS_S3_UPLOAD_BUCKET_NAME="{{ outline_bucket_name }}"
AWS_S3_UPLOAD_BUCKET_URL=https://storage.googleapis.com
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_UPLOAD_METHOD={{ outline_storage_upload_method | default('put') }}

# Hosts permitidos
ALLOWED_HOSTS="{{ outline_allowed_hosts }}"

{% if outline_google_client_id is defined and outline_google_client_id != "" %}
# Autenticação Google OAuth
GOOGLE_CLIENT_ID="{{ outline_google_client_id }}"
GOOGLE_CLIENT_SECRET="{{ outline_google_client_secret }}"
{% endif %}

{% if outline_github_client_id is defined and outline_github_client_id != "" %}
# Integração GitHub (Link Unfurling de Issues, Pull Requests e Projetos)
GITHUB_CLIENT_ID="{{ outline_github_client_id }}"
GITHUB_CLIENT_SECRET="{{ outline_github_client_secret }}"
GITHUB_APP_NAME="{{ outline_github_app_name }}"
GITHUB_APP_ID="{{ outline_github_app_id }}"
GITHUB_APP_PRIVATE_KEY="{{ outline_github_app_private_key }}"
{% if outline_github_webhook_secret is defined and outline_github_webhook_secret != "" %}
GITHUB_WEBHOOK_SECRET="{{ outline_github_webhook_secret }}"
{% endif %}
{% endif %}


{% if outline_smtp_host is defined and outline_smtp_host != "" %}
# Autenticação e Notificações por E-mail (SMTP)
SMTP_HOST="{{ outline_smtp_host }}"
SMTP_PORT={{ outline_smtp_port | default(587) }}
SMTP_USERNAME="{{ outline_smtp_username | default('') }}"
SMTP_PASSWORD="{{ outline_smtp_password | default('') }}"
SMTP_FROM_EMAIL="{{ outline_smtp_from_email | default('') }}"
SMTP_SECURE={{ outline_smtp_secure | default(false if (outline_smtp_port | default(587) == 587) else true) | lower }}
{% endif %}
